@namespace BlazorForm
@inherits BlazorFormInputBase

@* Presentational only: no input, no value, no validation. A long form reads as a set of titled
   sections rather than one undifferentiated column, without the host page having to interleave its
   own markup with the generated fields.

   The heading is a div carrying role="heading" rather than a fixed <h3>: a form is rendered inside a
   page whose outline the library cannot know, so the level has to be the caller's choice. *@
<div class="ff-static">
    @if (!string.IsNullOrEmpty(HeadingText))
    {
        <div class="ff-static__heading" id="@Context.ElementId" role="heading" aria-level="@Level">@HeadingText</div>
    }
    @if (!string.IsNullOrEmpty(Field.HelpText))
    {
        <p class="ff-static__text">@Field.HelpText</p>
    }
    @if (Divider)
    {
        <hr class="ff-static__divider" />
    }
</div>

@code {
    /// <summary>The heading text — the field's label, unless the schema asked for no label at all.</summary>
    private string? HeadingText => Field.ShowLabel ? Field.Label : null;

    /// <summary>Heading level, 1-6. Set with <c>Attr("level", 2)</c>; defaults to 3.</summary>
    private int Level => Math.Clamp(Attr("level", 3), 1, 6);

    /// <summary>Renders a horizontal rule below the content — set <c>Attr("divider", true)</c>.</summary>
    private bool Divider => Attr("divider", false);
}
