@page "/array"
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Array / repeater</PageTitle>

<div class="demo-intro">
    <h1>Array / repeater</h1>
    <p>
        Array fields render a repeating editor with add, remove and reorder. Each item is a nested
        object validated like any other field, and its errors travel with it when rows move. The
        <em>Total</em> below is a <strong>computed field</strong>: the schema derives it from the lines,
        so no page code keeps it in sync.
    </p>
</div>

<div class="demo-card">
    <BlazorFormView State="_state" OnValidSubmit="HandleSubmit" SubmitText="Save invoice" ShowErrorSummary="true" />
</div>

@if (_submitted)
{
    <div class="demo-result"><strong>Saved ✓</strong> <pre>@_json</pre></div>
}

<details class="demo-source">
    <summary>View source</summary>
    <pre><code>@Source</code></pre>
</details>

@code {
    private const string Source =
"""
@page "/array"
@rendermode InteractiveServer
@implements IDisposable

<BlazorFormView State="_state" OnValidSubmit="HandleSubmit" SubmitText="Save invoice" ShowErrorSummary="true" />

@code {
    private readonly Invoice _model = new();
    private BlazorFormState _state = default!;

    protected override void OnInitialized()
    {
        var schema = BlazorFormBuilder.For<Invoice>()
            .Title("New invoice")
            .Field(x => x.Customer, f => f.Required().Autocomplete("organization"))
            .Array(x => x.Lines, line => line
                    .Field(l => l.Description, f => f.Required())
                    .Field(l => l.Quantity, f => f.Range(1, 9999))
                    .Field(l => l.UnitPrice, f => f.Range(0, 1_000_000).Step(0.01))
                    // Each line's total is derived from its own quantity and price.
                    .Computed(l => l.LineTotal, l => l.Quantity * l.UnitPrice,
                              dependsOn: ["Quantity", "UnitPrice"]),
                f => f.Items(min: 1, message: "Add at least one line.").Attr("itemNoun", "line"))
            // ...and the invoice total from every line. Recomputed whenever anything under Lines changes.
            .Computed(x => x.Total, m => m.Lines.Sum(l => l.Quantity * l.UnitPrice),
                      dependsOn: [nameof(Invoice.Lines)])
            .Build();

        _state = new BlazorFormState(schema, new BlazorFormModelDataAccessor(_model));
        _state.StateChanged += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => _state.StateChanged -= OnStateChanged;
}
""";

    private readonly Invoice _model = new();
    private BlazorFormState _state = default!;
    private bool _submitted;
    private string _json = "";

    protected override void OnInitialized()
    {
        var schema = BlazorFormBuilder.For<Invoice>()
            .Title("New invoice")
            .Field(x => x.Customer, f => f.Required().Autocomplete("organization"))
            .Array(x => x.Lines, line => line
                    .Field(l => l.Description, f => f.Required())
                    .Field(l => l.Quantity, f => f.Range(1, 9999))
                    .Field(l => l.UnitPrice, f => f.Range(0, 1_000_000).Step(0.01))
                    .Computed(l => l.LineTotal, l => l.Quantity * l.UnitPrice,
                              dependsOn: ["Quantity", "UnitPrice"]),
                f => f.Items(min: 1, message: "Add at least one line.").Attr("itemNoun", "line"))
            .Computed(x => x.Total, m => m.Lines.Sum(l => l.Quantity * l.UnitPrice),
                      dependsOn: [nameof(Invoice.Lines)])
            .Build();

        _state = new BlazorFormState(schema, new BlazorFormModelDataAccessor(_model));
        _state.StateChanged += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void HandleSubmit(BlazorFormState state)
    {
        _submitted = true;
        _json = System.Text.Json.JsonSerializer.Serialize(_model,
            new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
    }

    public void Dispose() => _state.StateChanged -= OnStateChanged;
}
